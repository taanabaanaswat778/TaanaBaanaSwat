rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'PASTE_ADMIN_UID_HERE';
    }
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /orders/{id} {
      allow create: if request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50
                    && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }
  }
}
